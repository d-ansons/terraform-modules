{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default"
    ],
    "sharedGlobals": ["{workspaceRoot}/.tflint.hcl", "{workspaceRoot}/.checkov.yaml"]
  },
  "targetDefaults": {
    "init": {
      "cache": false,
      "inputs": ["{projectRoot}/**/*.tf"],
      "outputs": ["{projectRoot}/.terraform"]
    },
    "fmt": {
      "cache": true,
      "inputs": ["{projectRoot}/**/*.tf"]
    },
    "validate": {
      "cache": true,
      "dependsOn": ["init"],
      "inputs": ["{projectRoot}/**/*.tf"]
    },
    "lint": {
      "cache": true,
      "inputs": ["{projectRoot}/**/*.tf", "{workspaceRoot}/.tflint.hcl"]
    },
    "security-scan": {
      "cache": true,
      "inputs": ["{projectRoot}/**/*.tf"]
    },
    "docs": {
      "cache": true,
      "inputs": ["{projectRoot}/**/*.tf"],
      "outputs": ["{projectRoot}/README.md"]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    }
  ]
}
